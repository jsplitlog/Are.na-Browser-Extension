{
  "manifest_version": 3,
  "name": "Are.na Connections",
  "version": "0.1.1",
  "description": "See which public Are.na channels already hold the page you're on.",
  "permissions": ["activeTab", "storage", "identity"],
  "host_permissions": ["https://api.are.na/*"],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "content_security_policy": {
    "extension_pages": "default-src 'self'; connect-src https://api.are.na; img-src 'self' data: https:; object-src 'none'; base-uri 'none'"
  }
}
